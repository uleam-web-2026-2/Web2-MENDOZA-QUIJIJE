}

patch {
  url: {{baseUrl}}/inscripciones/{{canceladaId}}/estado
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{tokenOrganizador}}
}

body:json {
  {
    "estado": "confirmada"
  }
}

tests {
  test("Respuesta 422", function () {
    expect(res.status).to.equal(422);
  });
}
