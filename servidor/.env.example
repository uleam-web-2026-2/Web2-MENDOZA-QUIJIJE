# Copiar a .env y reemplazar los valores; .env no se sube a Git.
PORT=8080
# Clave del usuario eventosports de PostgreSQL; debe ser la misma en las dos lineas.
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_LOCAL
DATABASE_URL=postgres://eventosports:CAMBIAR_PASSWORD_LOCAL@localhost:5432/eventosports?sslmode=disable
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
# Solo para esta demostracion: crea ana y luis con claves de ejemplo.
DEMO_SEED=true
