# Copiar a .env y reemplazar los valores; .env no se sube a Git.
PORT=8080
# Clave del dueño de las tablas (el usuario que crea el contenedor de Compose).
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_LOCAL
# La API se conecta con su propio usuario: sin superusuario ni dueño de tablas.
DATABASE_URL=postgres://eventosports_api:CAMBIAR_CLAVE_API@localhost:5433/eventosports?sslmode=disable
# Solo para "go run . -migrar": crea y cambia las tablas, siembra y da permisos.
MIGRACION_DATABASE_URL=postgres://eventosports:CAMBIAR_PASSWORD_LOCAL@localhost:5433/eventosports?sslmode=disable
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
# Solo para esta demostracion: crea ana y luis con claves de ejemplo.
DEMO_SEED=true
